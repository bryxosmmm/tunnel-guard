/.third_party/
/.direnv/
/.uv-cache/
/.venv/
/scripts/
/experiments/
.env
.env.*
*.pem
*.key
.DS_Store

# Python generated files
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Locally built native accelerator
*.so
*.dylib
*.pyd
