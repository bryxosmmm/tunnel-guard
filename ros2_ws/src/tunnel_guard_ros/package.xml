<?xml version="1.0"?>
<package format="3">
  <name>tunnel_guard_ros</name>
  <version>0.1.0</version>
  <description>Live ROS 2 Humble PointCloud2 adapter for Tunnel Guard.</description>
  <maintainer email="maintainers@example.invalid">Tunnel Guard maintainers</maintainer>
  <license>UNLICENSED</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
