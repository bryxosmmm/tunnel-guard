  "reproduction": {
    "prerequisites": "Fresh worktree of this evidence branch, the recorded Python 3.12 environment, and the unchanged nine real recordings at the recipe paths. Existing output directories are intentionally not overwritten.",
    "commands": [
      "python setup.py build_ext --inplace --force",
      "mkdir -p build/attributes-baseline-source",
      "git archive f2dd7c4 tunnel_guard cpp setup.py MANIFEST.in | tar -x -C build/attributes-baseline-source",
      "cp tunnel_guard/_native*.so build/attributes-baseline-source/tunnel_guard/",
      "cp tunnel_guard/decode_benchmark.py tunnel_guard/compare_alarm_runs.py build/attributes-baseline-source/tunnel_guard/",
      "PYTHONPATH=build/attributes-baseline-source python -P -m tunnel_guard.run --experiment configs/attributes-before-20260923.json",
      "PYTHONPATH=. python -P -m tunnel_guard.run --experiment configs/attributes-after-20260923.json",
      "PYTHONPATH=. python -P -m tunnel_guard.decode_benchmark --experiment configs/attributes-decode-20260923.json",
      "PYTHONPATH=. python -P -m tunnel_guard.compare_alarm_runs --experiment configs/attributes-report-20260923.json"
    ],
    "note": "Run the invalid-before/invalid-after recipes with the same respective sources, then invalid-report and invalid-decode. Original full logs are retained locally as verified lossless gzip archives; restore them before using the comparator on saved runs. Native binary hashes may differ across build locations; both arms of one comparison must use the same freshly built binary."
